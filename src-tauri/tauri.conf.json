{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "牛马上班",
  "version": "0.2.0",
  "identifier": "com.hcxgrassstar.niuma",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run sync:frontend",
    "beforeBuildCommand": "npm run sync:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "牛马上班",
        "width": 390,
        "height": 640,
        "minWidth": 340,
        "minHeight": 560,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
